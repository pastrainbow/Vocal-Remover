# Single environment for the whole app: web API, Tidal downloader, GPU separation.
#
# Compile with:
#   uv pip compile requirements/app.in -o requirements/app.lock \
#       --python-version 3.11 --python-platform windows \
#       --index-strategy unsafe-best-match --emit-index-url
#
# Install with (the strategy flag is required at SYNC time too, not just compile):
#   uv venv venv --python 3.11
#   uv pip sync requirements/app.lock --index-strategy unsafe-best-match
#
# ---------------------------------------------------------------------------
# Both index settings below are load-bearing:
#   * the explicit "+cu128" local version is the ONLY thing that stops uv
#     resolving PyPI's CPU-only win_amd64 torch wheel. That wheel installs and
#     runs fine - silently on CPU, ~10x slower, with no error anywhere.
#   * --index-strategy unsafe-best-match is required because uv otherwise
#     restricts torch to the first index that carries it, which is PyPI.
# ---------------------------------------------------------------------------
--index-url https://download.pytorch.org/whl/cu128
--extra-index-url https://pypi.org/simple

# --- GPU separation -------------------------------------------------------
torch==2.8.0+cu128
# torchvision arrives transitively via onnx2torch-py313; pinned to a matching
# +cu128 build because a CPU torchvision beside a CUDA torch risks DLL/symbol
# mismatches on Windows.
torchvision==0.23.0+cu128

# PIN, DO NOT FLOAT. onnxruntime-gpu 1.30.0 is built against CUDA 13 and cannot
# see torch cu128's CUDA 12 DLLs; every .onnx model (all of MDX-Net) then falls
# back to CPU *silently*. 1.22.0 is the CUDA 12 / cuDNN 9 build, matching the
# DLLs torch already ships in torch/lib.
# It also requires that `import torch` happens BEFORE any onnxruntime session is
# created, so torch registers its DLL directory. That ordering is not
# enforceable here - see the import comments in the worker.
onnxruntime-gpu==1.22.0

audio-separator[gpu]==0.47.0

# torch.compile's GPU backend. torch's Linux wheels depend on triton; its
# Windows wheels do not, and upstream triton ships no Windows build, so this is
# the community port. Without it torch.compile fails at the first forward and
# audio-separator falls back to eager inference - about 2x slower on
# BS-Roformer, measured on an RTX 3060. The minor version must track torch's:
# triton-windows 3.4 is the build for torch 2.8.
triton-windows>=3.4,<3.5; sys_platform == "win32"

# --- Tidal downloader -----------------------------------------------------
# python-tidal handles auth, metadata and stream resolution. It is maintained
# (0.8.x, Jan 2026) and, critically, tracks Tidal's client credentials: the
# hardcoded keys in yaronzz/Tidal-Media-Downloader (last real commit Oct 2023)
# have been revoked for playback - they still authenticate, but every
# playbackinfo request returns 401 subStatus 4005.
tidalapi>=0.8.11

# Tagging the downloaded file. tidalapi resolves streams but does not tag.
mutagen>=1.45

# --- Web API --------------------------------------------------------------
fastapi
uvicorn[standard]
pydantic-settings
sse-starlette
python-multipart
httpx
